{
  "name": "Kali XFCE VNC",
  "image": "kalilinux/kali-rolling",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": { "label": "noVNC", "onAutoForward": "openBrowser" }
  },
  "remoteUser": "root",
  "containerEnv": {
    "DISPLAY": ":1",
    "DEBIAN_FRONTEND": "noninteractive"
  }
}
